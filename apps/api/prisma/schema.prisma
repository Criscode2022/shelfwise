generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum HouseholdRole { OWNER MEMBER }
enum ItemLocation { FRIDGE FREEZER PANTRY COUNTER OTHER }
enum ListStatus { OPEN DONE }
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  createdAt DateTime @default(now())
  memberships HouseholdMember[]
  items InventoryItem[]
  lists ShoppingList[]
}
model Household {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  members HouseholdMember[]
  items InventoryItem[]
  lists ShoppingList[]
}
model HouseholdMember {
  id String @id @default(cuid())
  role HouseholdRole @default(MEMBER)
  userId String
  householdId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  @@unique([userId, householdId])
}
model InventoryItem {
  id String @id @default(cuid())
  name String
  category String
  quantity Float
  unit String
  location ItemLocation @default(PANTRY)
  expiresOn DateTime?
  unitCostCents Int @default(0)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  householdId String
  createdById String
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])
}
model ShoppingList {
  id String @id @default(cuid())
  title String
  status ListStatus @default(OPEN)
  createdAt DateTime @default(now())
  householdId String
  createdById String
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])
  lines ListLine[]
}
model ListLine {
  id String @id @default(cuid())
  name String
  quantity Float @default(1)
  unit String @default("pcs")
  checked Boolean @default(false)
  listId String
  list ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
}
